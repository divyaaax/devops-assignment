# ==============================================================================
# DevOps Assessment - Environment Variables Template
# Copy this file to .env for local development:
#   cp .env.example .env (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
# ==============================================================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=*

# Redis Message Broker & Result Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_USE_SSL=false

# Task Simulation Duration (in seconds)
TASK_SIMULATION_SECONDS=2

# ==============================================================================
# Real Email Delivery Settings (Gmail SMTP)
# Set ENABLE_REAL_EMAIL=true and supply your Gmail address & 16-char App Password
# ==============================================================================
ENABLE_REAL_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password
SMTP_FROM=your_email@gmail.com
