# ==============================================================================
# Development Environment - Example Variables
# Copy to terraform.tfvars:
#   cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

aws_region         = "us-east-1"
project_name       = "devops-assessment"
environment        = "dev"
availability_zones = ["us-east-1a", "us-east-1b"]
vpc_cidr           = "10.0.0.0/16"

# Cost Optimization: set enable_nat_gateway to false to avoid ~$35/month NAT Gateway charges
# ECS tasks are placed in public subnets with direct internet access for ECR image pulls.
enable_nat_gateway = false

fargate_cpu        = "256"
fargate_memory     = "512"
log_retention_days = 7
