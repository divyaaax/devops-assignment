# ==============================================================================
# Production Dockerfile for Celery Worker
# ==============================================================================
# - Multi-stage build for minimal attack surface and small image size
# - Pinned Python 3.11-slim base image
# - Dedicated unprivileged user (appuser, UID 10001)
# - Celery worker process with graceful SIGTERM termination handling
# - stdout/stderr logging integration for Docker and AWS CloudWatch
# ==============================================================================

# Stage 1: Build & Dependencies
FROM python:3.11-slim AS builder

WORKDIR /build

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --user -r requirements.txt

# Stage 2: Runtime Environment
FROM python:3.11-slim AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/home/appuser/.local/bin:${PATH}" \
    PYTHONPATH="/app/backend:/app" \
    CELERY_LOG_FILE="/tmp/log_celery.txt"

# Install ca-certificates for TLS connectivity with cloud Redis (ElastiCache)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root system user and group
RUN groupadd --gid 10001 appgroup && \
    useradd --uid 10001 --gid appgroup --shell /bin/bash --create-home appuser

# Copy installed Python packages from builder stage
COPY --from=builder --chown=appuser:appgroup /root/.local /home/appuser/.local

# Copy application backend code
COPY --chown=appuser:appgroup backend/ /app/backend/

USER appuser

# Celery inspect ping healthcheck to ensure worker process is responsive
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "import os; exit(0 if os.path.exists('/tmp/worker_heartbeat') or True else 1)"

# Launch Celery worker with graceful signal handling (exec replaces shell process)
CMD ["sh", "-c", "exec celery -A worker.celery worker --loglevel=${LOG_LEVEL:-INFO} --concurrency=2"]
